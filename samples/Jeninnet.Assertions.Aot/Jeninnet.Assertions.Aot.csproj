<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
        <PublishAot Condition="'$(AotSample)' == 'true'">true</PublishAot>
        <PublishTrimmed Condition="'$(TrimSample)' == 'true'">true</PublishTrimmed>
        <TrimMode Condition="'$(TrimSample)' == 'true'">full</TrimMode>
        <TrimmerSingleWarn>false</TrimmerSingleWarn>
        <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Jeninnet.Assertions\Jeninnet.Assertions.csproj" />
    </ItemGroup>

</Project>
